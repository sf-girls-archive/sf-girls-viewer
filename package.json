{
  "name": "sf-girls-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "allowScripts": {
    "esbuild@0.25.1": true
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "generate-entity-map": "node generate-entity-map.js",
    "generate-gallery-thumbnails": "node scripts/generate-gallery-thumbnails.js",
    "postinstall": "git lfs install"
  },
  "dependencies": {
    "@vercel/analytics": "1.4.1",
    "gifenc": "1.0.3",
    "jotai": "2.10.3",
    "pixi-live2d-display": "0.5.0-beta",
    "pixi-spine": "4.0.4",
    "pixi.js": "7.4.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-image-gallery": "1.3.0",
    "react-router-dom": "7.13.1",
    "react-select": "5.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/react-image-gallery": "1.2.4",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "typescript": "5.6.2",
    "typescript-eslint": "8.72.1",
    "vite": "6.4.1"
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
}
